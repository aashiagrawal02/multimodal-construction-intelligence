# OpenAI-compatible endpoint serving a Meta LLaMA vision model.
# Examples:
#   Groq:        https://api.groq.com/openai/v1   model: meta-llama/llama-4-scout-17b-16e-instruct
#   OpenRouter:  https://openrouter.ai/api/v1     model: meta-llama/llama-3.2-11b-vision-instruct
#   Together:    https://api.together.xyz/v1      model: meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Leave LLM_API_KEY empty to run in DEMO mode (deterministic mock responses).

# Pollinations (Flux) needs no key
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
POLLINATIONS_MODEL=flux

CORS_ORIGINS=http://localhost:5173
